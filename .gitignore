# 「纸上」博客系统 — Git 忽略规则

# 运行时数据（SQLite 数据库、SECRET_KEY、备份）
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/

# 环境变量与密钥
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
*.swp
*~

# 日志与临时文件
*.log
tmp/
