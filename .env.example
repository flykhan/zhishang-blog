# 「纸上」博客系统 — 环境变量示例
# 使用：cp .env.example .env，按需修改后 docker compose up -d --build
# .env 会被 docker compose 自动加载（用于变量插值），并作为 env_file 注入容器。
# 注意：.env 含密钥，已被 .gitignore / .dockerignore 忽略，不要提交到仓库。

# ---------------------------------------------------------------------------
# 会话签名密钥 SECRET_KEY
# 留空/不设置时，后端会自动生成并持久化到 /data/.secret_key（推荐默认行为）。
# 也可以显式指定一个随机值（生产环境建议显式设置）：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 更换 SECRET_KEY 会使所有已登录会话失效。
# ---------------------------------------------------------------------------
# SECRET_KEY=请替换为随机字符串

# 数据目录与 SQLite 数据库路径（容器内路径，默认无需修改）
DATA_DIR=/data
DB_PATH=/data/blog.db

# 首次初始化管理员账号（仅当数据库为空时生效；部署后请立即在后台修改密码）
# ADMIN_PASSWORD 留空或不设置时，应用会生成随机初始密码：
#   - 写入容器内 /data/initial_admin_password.txt（即 docker 卷 blog-data）
#   - 同时打印到启动日志：docker compose logs blog | grep 初始密码
# 想自己指定初始密码时，取消下面一行注释并替换为强密码。
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=替换为强密码

# 站点绝对链接前缀，用于 RSS / sitemap 中的绝对地址
# 部署到公网时改成真实域名，例如 https://blog.example.com
SITE_URL=http://localhost:8080

# 展示时区（数据始终以 UTC 存储，仅影响页面展示）
SITE_TZ=Asia/Shanghai

# 宿主机映射端口（容器内固定 8000；服务只绑定 127.0.0.1，公网请用反向代理）
BLOG_PORT=8080

# 数据卷名称（默认 blog-data；同机多实例或迁移时可改）
DATA_VOLUME=blog-data

# 评论功能初始化默认开关（true/false；初始化后以后台设置为准）
ALLOW_COMMENTS=true

# HTTPS 部署时设为 true，Cookie 将带 Secure 标记
COOKIE_SECURE=false

# 登录会话有效期（秒），默认 7 天
SESSION_MAX_AGE=604800

# 反向代理（Nginx/Caddy）后设为 true，从 X-Forwarded-For 获取真实客户端 IP；
# 直连时保持 false，避免伪造请求头绕过登录/评论限流。
TRUST_PROXY=false

# 单次请求体上限（字节），默认 1 MiB
MAX_BODY_BYTES=1048576
